pipeline {

    agent none
    
    //no descarga el codigo fuente en todos los agentes
    options{ skipDefaultCheckout() }
    
    stages {
        stage('Get Code') {
			agent { label 'windows' }
            steps {
                //limpio y obtengo el codigo del repositorio
				cleanWs()
                git 'https://github.com/jclmon/devops-helloword-repository.git'
                sh "whoami"
                sh "hostname"
                echo WORKSPACE
                bat 'dir'
				stash name:'code', includes:'**'
            }
        }
		stage('Tests Paralelos') {
            parallel {
				stage('Unit') {
					agent { label 'python' }
					steps {
						sh "whoami"
						sh "hostname"
						echo WORKSPACE
						
						catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
							unstash 'code'
							
							bat '''
								set PYTHONPATH=%WORKSPACE%
								coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit
								coverage xml
							'''
							junit testResults: 'result-unit.xml' 
							//datos de coverage
							stash name: 'coverage-data', includes: '.coverage'
						}
					}
				}
				stage('Rest') {
					agent { label 'windows' }
					steps {
						sh "whoami"
						sh "hostname"
						echo WORKSPACE

						catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
							unstash 'code'
							
							bat '''
								echo 'Variable entorno para flask'
								set FLASK_APP=app\\api.py
								echo 'Ejecuto flask en background'
								start flask run
								echo 'Arranco wiremock con el mock de microservicios'
								start java -jar C:\\Producto\\wiremock\\wiremock-standalone-3.3.1.jar --port 9090 --v --root-dir test\\wiremock
								sleep 10
								echo 'Ejecuto los test sobre los microservicios'
								set PYTHON_PATH=%WORKSPACE%
								pytest --junitxml=result-rest.xml test\\rest
							'''
							junit skipPublishingChecks: true, testResults: 'result-rest.xml' 
						}
					}
				} 
				stage('Static') {
					agent { label 'python' }
					steps {
						sh "whoami"
						sh "hostname"
						echo WORKSPACE

						catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
							unstash 'code'
							
							bat '''
								flake8 --exit-zero --format=pylint app > result-flake8.out
							'''
							recordIssues enabledForFailure: true, tools:
								[ flake8(name: 'Flake8', pattern: 'result-flake8.out') ],
								qualityGates: [
											    [threshold: 8, type: 'TOTAL', criticality: 'UNSTABLE'],
										        [threshold: 10, type: 'TOTAL', criticality: 'FAILURE'],
											  ]
						}
					}
				}    
				stage('Security') {
					agent { label 'python' }
					steps {					
						sh "whoami"
						sh "hostname"
						echo WORKSPACE

						script {
							catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
								unstash 'code'
								
								// Ejecuto Bandit con un formato que PyLint entienda
								bat """
									bandit -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}" --exit-zero
								"""
							
								// Registro los issues
								// 'recordIssues' devuelve una lista de resultados
								def results = recordIssues enabledForFailure: true, tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')]
								
								if (results != null && !results.isEmpty()) {
									
									// Si tenemos resultados
									int totalIssues = results[0].getTotalSize()
									
									echo "Total de issues detectados: ${totalIssues}"
							
									if (totalIssues >= 4) {
										error "ETAPA FALLIDA: Se encontraron ${totalIssues} issues."
									} else if (totalIssues >= 2) {
										currentBuild.result = 'UNSTABLE'
									}
									
								} else {
									echo "Jenkins no pudo encontrar o parsear ningún issue en bandit.out"
								}
							}
						}						
					}
				}
				stage('Performance') {
					agent { label 'windows' }
					steps {				
						sh "whoami"
						sh "hostname"
						echo WORKSPACE
						
						catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
							unstash 'code'
							
							bat '''
								echo 'Variable entorno para flask'
								set FLASK_APP=app\\api.py
								echo 'Ejecuto flask en background'
								start flask run
								sleep 5
								C:\\Producto\\apache-jmeter-5.6.3\\bin\\jmeter.bat -n -t test\\jmeter\\flask.jmx -f -l flask.jtl
								'''
							perfReport sourceDataFiles: 'flask.jtl'
						}
					}
				}	
			}
		}
		stage('Coverage') {
			agent { label 'python' }
			steps {
				sh "whoami"
				sh "hostname"
				echo WORKSPACE
				
				catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
					echo 'Recuperamos los datos de cobertura de la ejecucion junit para generar el XML sin ejecutar los test de nuevo'
					unstash 'coverage-data'
					bat 'python -m coverage xml'
					recordCoverage qualityGates: [
							// Si es menor a 95%, marcar como UNSTABLE
							[threshold: 95.0, metric: 'LINE', baseline: 'PROJECT', criticality: 'UNSTABLE'],
							// Si es menor a 85%, marcar como FAILURE
							[threshold: 85.0, metric: 'LINE', baseline: 'PROJECT', criticality: 'FAILURE'],
							// Si es menor a 90%, marcar como UNSTABLE
							[threshold: 90.0, metric: 'BRANCH', baseline: 'PROJECT', criticality: 'UNSTABLE'],
							// Si es menor a 80%, marcar como FAILURE
							[threshold: 80.0, metric: 'BRANCH', baseline: 'PROJECT', criticality: 'FAILURE']
						],
						enabledForFailure: true,
						tools: [
							[parser: 'COBERTURA', pattern: 'coverage.xml']
						]
				}
			}
		}		
    }    
	post {
		always {
		    //limpio el workspace
			node('windows') {
				cleanWs(disableDeferredWipeout: true, deleteDirs: true, notFailBuild: true)
			}
			node('python') {
				cleanWs(disableDeferredWipeout: true, deleteDirs: true, notFailBuild: true)
			}
		}
	}	
	
}